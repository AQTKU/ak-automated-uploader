{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"lib": [
			"DOM.AsyncIterable",
			"ESNext.Object",
			"ES2021.String"
		],
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"rewriteRelativeImportExtensions": true,
		"noImplicitReturns": true,
		"sourceMap": true
	},
	"include": [
		"src",
		"adapter",
		"vite.config.ts"
	]
}
