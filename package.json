{
	"name": "ak-automated-uploader",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "bunx --bun svelte-kit sync || echo ''",
		"test": "bun test",
		"check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.5",
		"svelte": "^5.56.9",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"cheerio": "^1.2.0",
		"iso-639-2": "^3.0.2",
		"liquidjs": "^10.29.0",
		"mediainfo.js": "^0.3.7",
		"p-queue": "^9.3.3",
		"svelte-dnd-action": "^0.9.78",
		"valibot": "^1.4.2"
	}
}
